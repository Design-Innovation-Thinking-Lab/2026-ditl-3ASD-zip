# ditl-sbp 雲端版的環境變數（只寫名稱，值由老師在 Vercel 設定，不要 commit 真的值）
# 類型：Sensitive＝機密；Config＝一般設定。Vercel 上一律勾 Production 和 Preview。

# 資料庫（Sensitive）：Supabase「Connect」頁的連線字串，格式在設計文件決定
SBP_DATABASE_URL=

# 登入（Config，Email 名單除外）
SBP_AUTH_MODE=
SBP_AUTH_ALLOWED_EMAILS=
SBP_AUTH_PUBLIC_BASE_URL=
SBP_AUTH_FROM_EMAIL=
SBP_AUTH_COOKIE_SECURE=

# 寄信（沿用既有登入時才需要；SBP_SMTP_PASSWORD 是 Sensitive）
SBP_SMTP_HOST=
SBP_SMTP_PORT=
SBP_SMTP_USERNAME=
SBP_SMTP_PASSWORD=

# AI（Sensitive）：研究室為這個專案單獨開的 Anthropic key，有每月上限
ANTHROPIC_API_KEY=

# 排程（Sensitive）：Vercel Cron 呼叫時帶的密碼
CRON_SECRET=
